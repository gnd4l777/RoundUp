# Local coordination files for the RoundUp help desk automation.
# These live only on this machine and were never meant to be part of the
# app's git history — ignoring them means they can't accidentally get
# bundled into a pull request, and a `git reset --hard` never wipes them.
DIGEST.md
PENDING_APPROVAL.md
TASKS.md
KADEN-TASKS.md
ACTION-NEEDED.md
.checkin-logs/
.claude-session.lock

# These two scripts hardcode a real ntfy.sh topic. ntfy topics have no
# auth, so the topic name itself is the credential — committing it to
# this public repo would let anyone read Kaden's alerts or spoof pushes
# to his phone. Must stay untracked.
scripts/urgent-ping.sh
scripts/run-checkin.sh
